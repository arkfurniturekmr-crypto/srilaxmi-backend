# Copy this file to .env and fill in real values. Never commit the real .env file.

# Port the API server listens on
PORT=4000

# development | production
NODE_ENV=development

# Public base URL of THIS backend once deployed (used to build PDF download links).
# Local example: http://localhost:4000
# Production example: https://api.srilaxmisawmill.com
BASE_URL=http://localhost:4000

# Comma-separated list of origins allowed to call this API.
# Must include your live website domain(s).
CORS_ORIGIN=https://srilaxmisawmill.com,https://www.srilaxmisawmill.com,http://localhost:5500

# Folder (relative to project root) where generated quotation PDFs are stored
STORAGE_DIR=storage/quotations
